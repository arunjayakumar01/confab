# Copy to .env.real (git-ignored) and fill in from your Workspace org's GCP project.
# Load with: make desktop-real / make relay-real

# --- Google endpoints (fixed) ---
PRISM_CHAT_API=https://chat.googleapis.com
PRISM_OAUTH_AUTH=https://accounts.google.com/o/oauth2/v2/auth
PRISM_OAUTH_TOKEN=https://oauth2.googleapis.com/token
PRISM_USERINFO=https://openidconnect.googleapis.com/v1/userinfo

# --- OAuth client of type "Desktop app" from the GCP project (consent screen: Internal) ---
PRISM_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
PRISM_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Relay ---
PRISM_RELAY_WS=ws://127.0.0.1:8080/ws
# Workspace Events are delivered to this topic (the relay creates the subscriptions with your token):
PRISM_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/prism-events
# The relay pulls from this subscription (no public URL needed):
PRISM_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT_ID/subscriptions/prism-relay-pull
# Service-account key with roles/pubsub.subscriber on that subscription (scripts/gcp-setup.sh writes it).
# Unset, the relay reads your gcloud ADC file instead, which Workspace orgs with Google Cloud session
# control reject (invalid_rapt), so only use that outside such an org.
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/prism/prism-relay-sa.json

# --- Desktop ---
# keyring = macOS Keychain (packaged builds). `cargo tauri dev` rebuilds change the binary's signature and
# the Keychain asks again each time, so dev loops use file (0600 under the profile dir).
PRISM_TOKEN_STORE=file
