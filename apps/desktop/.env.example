# Browser mode reads the same names as the Rust core, prefixed with VITE_.
VITE_PRISM_CHAT_API=http://127.0.0.1:8081
VITE_PRISM_OAUTH_AUTH=http://127.0.0.1:8081/o/oauth2/v2/auth
VITE_PRISM_OAUTH_TOKEN=http://127.0.0.1:8081/token
VITE_PRISM_USERINFO=http://127.0.0.1:8081/oauth2/v3/userinfo
VITE_PRISM_RELAY_WS=ws://127.0.0.1:8080/ws
VITE_PRISM_CLIENT_ID=prism-dev
# Twin convenience: skip the sign-in click as this user
# VITE_PRISM_TWIN_USER=users/1001
