{
  "name": "@prism/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Confab, an unofficial desktop client for Google Chat and Google Workspace",
  "license": "MIT",
  "homepage": "https://github.com/arunjayakumar01/confab",
  "repository": { "type": "git", "url": "git+https://github.com/arunjayakumar01/confab.git" },
  "keywords": ["google-chat", "google-workspace", "desktop-client", "tauri", "react"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "dev:mock": "VITE_BRIDGE=mock vite --port 1430"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.0",
    "@tauri-apps/api": "^2.9.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
